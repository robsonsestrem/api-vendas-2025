{
  "name": "api-vendas",
  "version": "1.0.0",
  "private": true,
  "main": "dist/shared/infra/http/server.js",
  "license": "MIT",
  "engines": {
    "node": "^20.17.0 || >=22.9.0",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node dist/shared/infra/http/server.js",
    "dev": "ts-node-dev -r tsconfig-paths/register --inspect --transpile-only --ignore-watch node_modules src/shared/infra/http/server.ts",
    "build": "babel src --extensions \".js,.ts\" --out-dir dist --copy-files --ignore \"**/*.d.ts\"",
    "lint": "eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm migration:run -- -d src/shared/infra/typeorm/index.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d src/shared/infra/typeorm/index.ts",
    "migration:show": "npm run typeorm migration:show -- -d src/shared/infra/typeorm/index.ts",
    "test": "jest",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@babel/cli": "^7.12.10",
    "@babel/core": "^7.12.10",
    "@babel/node": "^7.12.10",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/plugin-proposal-decorators": "^7.12.12",
    "@babel/preset-env": "^7.12.11",
    "@babel/preset-typescript": "^7.12.7",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.8",
    "@types/express": "^4.17.9",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^8.5.0",
    "@types/mime": "^2.0.3",
    "@types/multer": "^1.4.5",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^4.9.0",
    "@typescript-eslint/parser": "^4.9.0",
    "babel-plugin-module-resolver": "^4.1.0",
    "babel-plugin-transform-typescript-metadata": "^0.3.1",
    "eslint": "^7.14.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-prettier": "^3.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^2.2.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "aws-sdk": "^2.830.0",
    "bcryptjs": "^2.4.3",
    "celebrate": "^13.0.4",
    "class-transformer": "^0.3.1",
    "cors": "^2.8.5",
    "date-fns": "^2.16.1",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-async-errors": "^3.1.1",
    "handlebars": "^4.7.6",
    "ioredis": "^5.4.1",
    "joi": "^17.4.0",
    "jsonwebtoken": "^8.5.1",
    "mime": "^2.5.0",
    "multer": "^1.4.2",
    "nodemailer": "^6.4.17",
    "pg": "^8.5.1",
    "rate-limiter-flexible": "^2.1.16",
    "reflect-metadata": "^0.1.13",
    "swagger-ui-express": "^4.6.3",
    "tsyringe": "^4.4.0",
    "typeorm": "^0.3.6",
    "uuid": "^8.3.2"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  }
}
